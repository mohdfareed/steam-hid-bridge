;
; Steam HID Bridge Virtual Mouse
;

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ManufacturerName%
CatalogFile=SteamHidBridge.VirtualMouse.cat
DriverVer=05/10/2026,0.1.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
SteamHidBridge.VirtualMouse.sys=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=Install, Root\SteamHidBridgeVirtualMouse

[Install.NT]
CopyFiles=Driver_CopyFiles

[Driver_CopyFiles]
SteamHidBridge.VirtualMouse.sys

[Install.NT.HW]
AddReg=Vhf_AddReg

[Vhf_AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[Install.NT.Services]
AddService=SteamHidBridgeVirtualMouse,0x00000002,Service_Install

[Service_Install]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SteamHidBridge.VirtualMouse.sys

[Strings]
ManufacturerName="mohdfareed"
DeviceName="Steam HID Bridge Virtual Mouse"
ServiceName="Steam HID Bridge Virtual Mouse"
DiskName="Steam HID Bridge Virtual Mouse Install Disk"
