<UserControl x:Class="SteamHidBridge.App.Ui.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <GroupBox Header="Mouse">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Pointer"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding PointerText}"
                           FontFamily="Consolas"/>

                <TextBlock Grid.Row="1"
                           Text="Wheel"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding WheelText}"
                           FontFamily="Consolas"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="2"
                           Text="Buttons"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding MouseButtonsText}"
                           FontFamily="Consolas"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="3"
                           Text="Last output"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding LastOutputText}"
                           FontFamily="Consolas"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="4"
                           Text="Forwarding"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding ForwardingText}"
                           FontFamily="Consolas"
                           Margin="0,8,0,0"/>

                <TextBlock Grid.Row="5"
                           Text="Output"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Text="{Binding OutputTargetText}"
                           Margin="0,8,0,0"/>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
