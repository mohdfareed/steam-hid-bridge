<Window x:Class="SteamHidBridge.App.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SteamHidBridge.App.Ui.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Assets/SteamHidBridge.ico"
        Width="900"
        Height="660"
        MinWidth="760"
        MinHeight="500"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Steam HID Bridge" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProcessText}" />
        </StackPanel>

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,10">
            <StatusBar Padding="4,0">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{Binding StatusBrush}"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ForwardingStatus}" />
                    </StackPanel>
                </StatusBarItem>
                <TextBlock Text="|"
                           Margin="4,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <StatusBarItem>
                    <TextBlock Text="{Binding InputSourceText}" />
                </StatusBarItem>
                <TextBlock Text="|"
                           Margin="4,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <StatusBarItem>
                    <TextBlock Text="{Binding OutputTargetText}" />
                </StatusBarItem>
            </StatusBar>
        </Border>

        <TabControl>
            <TabItem Header="Profiles">
                <views:ProfileSettingsView Margin="12" />
            </TabItem>
            <TabItem Header="Settings">
                <views:GeneralSettingsView Margin="12" />
            </TabItem>
            <TabItem Header="Output">
                <views:OutputView Margin="12" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
