<UserControl x:Class="SteamHidBridge.App.Views.GameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Game">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Entry" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1">
                <Button DockPanel.Dock="Right"
                        Content="New"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        Command="{Binding NewGameCommand}" />
                <ComboBox ItemsSource="{Binding GameIds}" SelectedItem="{Binding SelectedGameId}" />
            </DockPanel>

            <TextBlock Grid.Row="1" Text="Id" Margin="0,8,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding EditGameId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Text="Title" Margin="0,8,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Text="Executable" Margin="0,8,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding EditExecutable, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Text="Args" Margin="0,8,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding EditArguments, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Text="Working dir" Margin="0,8,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="{Binding EditWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="6" Text="Receivers" Margin="0,8,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="{Binding EditReceiverProcessesText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Save" Command="{Binding SaveGameCommand}" />
                <Button Content="Launch" Margin="8,0,0,0" Command="{Binding LaunchGameCommand}" />
                <Button Content="Copy SRM JSON" Margin="8,0,0,0" Command="{Binding CopySteamRomManagerJsonCommand}" />
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>
