<UserControl x:Class="SteamHidBridge.App.Views.GameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Profile"
                  HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Entry" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding GameIds}"
                          SelectedItem="{Binding SelectedGameId}"
                          ToolTip="Select a saved profile." />
                <Button Grid.Column="2"
                        Width="160"
                        Content="New"
                        Command="{Binding NewGameCommand}"
                        ToolTip="Create a new profile." />

                <TextBlock Grid.Row="1"
                           Text="Id *"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding EditGameId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Profile id used by --profile." />

                <TextBlock Grid.Row="2"
                           Text="Title"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Display name for this profile." />

                <TextBlock Grid.Row="3"
                           Text="Executable *"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding EditExecutable, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Executable launched by this profile." />

                <TextBlock Grid.Row="4"
                           Text="Args"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding EditArguments, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Launch arguments for the executable." />

                <TextBlock Grid.Row="5"
                           Text="Working dir"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding EditWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Working directory for the launched process." />

                <TextBlock Grid.Row="6"
                           Text="Receivers *"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding EditReceiverProcessesText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Process names that enable forwarding when foreground. Separate multiple receivers with commas, semicolons, or new lines. Example: ExampleGame.exe, ExampleLauncher.exe" />

                <StackPanel Grid.Row="7"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Width="160"
                            Content="Save"
                            Margin="0,0,8,0"
                            Command="{Binding SaveGameCommand}"
                            ToolTip="Save this profile." />
                    <Button Width="160"
                            Content="Launch"
                            Command="{Binding LaunchGameCommand}"
                            ToolTip="Launch this profile's executable." />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Header="General"
                  HorizontalContentAlignment="Stretch"
                  Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Grid.ColumnSpan="2"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          ToolTip="Choose the app theme." />

                <TextBlock Grid.Row="1"
                           Text="SRM manifest"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Text="{Binding SrmManifestPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Manifest JSON path used by your Steam ROM Manager parser." />

                <TextBlock Grid.Row="2"
                           Text="App data"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,8,8,0"
                         Text="{Binding AppDataPath, Mode=OneWay}"
                         IsReadOnly="True"
                         ToolTip="Folder containing appsettings.json, logs, and generated data." />
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Width="160"
                        Content="Open"
                        Margin="0,8,0,0"
                        Command="{Binding OpenAppDataCommand}"
                        ToolTip="Open the app data folder." />

                <TextBlock Grid.Row="3"
                           Text="Driver"
                           Margin="0,12,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding DriverStatusText}"
                           Foreground="{Binding DriverStatusBrush}"
                           Margin="0,12,8,0"
                           VerticalAlignment="Center" />
                <Button Grid.Row="3"
                        Grid.Column="2"
                        Width="160"
                        Content="Install Driver"
                        Margin="0,12,0,0"
                        Command="{Binding InstallDriverCommand}"
                        ToolTip="Open the virtual mouse driver installer as administrator." />

                <TextBlock Grid.Row="4"
                           Text="Version"
                           Margin="0,12,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding VersionText}"
                           Margin="0,12,8,0"
                           VerticalAlignment="Center" />
                <Button Grid.Row="4"
                        Grid.Column="2"
                        Width="160"
                        Content="Check for Updates"
                        Margin="0,12,0,0"
                        Command="{Binding CheckForUpdateCommand}"
                        ToolTip="Check GitHub Releases for a newer version." />

                <Button Grid.Row="5"
                        Grid.Column="2"
                        Width="160"
                        Content="Save"
                        Margin="0,8,0,0"
                        Command="{Binding SaveGeneralCommand}"
                        ToolTip="Save general settings and write Steam ROM Manager JSON." />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
