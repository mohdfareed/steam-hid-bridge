<Window x:Class="SteamHidBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SteamHidBridge.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Assets/SteamHidBridge.ico"
        Width="900"
        Height="600"
        MinWidth="760"
        MinHeight="420"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10"
                             Height="10"
                             Fill="{Binding StatusBrush}"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ForwardingStatus}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="{Binding ActivityText}" />
        </StatusBar>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Steam HID Bridge" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding InstanceText}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid MinWidth="720" Margin="0,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <views:GameSettingsView />
                <views:OutputView Grid.Column="2" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
