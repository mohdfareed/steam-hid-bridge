<UserControl x:Class="SteamHidBridge.App.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Header="Mouse">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Pointer" />
                <TextBlock Grid.Column="1" Text="{Binding PointerText}" FontFamily="Consolas" />

                <TextBlock Grid.Row="1" Text="Wheel" Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WheelText}" FontFamily="Consolas" Margin="0,8,0,0" />

                <TextBlock Grid.Row="2" Text="Buttons" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MouseButtonsText}" FontFamily="Consolas" Margin="0,8,0,0" />

                <TextBlock Grid.Row="3" Text="Loop" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InputLoopText}" FontFamily="Consolas" Margin="0,8,0,0" />

                <TextBlock Grid.Row="4" Text="Steam" Margin="0,8,0,0" />
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding SteamInputText, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Margin="0,8,0,0"
                         ToolTip="Steam Input API status." />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Last mouse frame" Margin="0,16,0,0">
            <TextBlock Text="{Binding LastOutputText}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas" />
        </GroupBox>
    </Grid>
</UserControl>
