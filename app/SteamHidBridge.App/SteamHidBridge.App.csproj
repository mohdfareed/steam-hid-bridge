<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Required for System.Windows.Forms.NotifyIcon tray support. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by LibraryImport-generated Win32 interop; app logic should not use unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>SteamHidBridge</AssemblyName>
    <ApplicationIcon>Assets\SteamHidBridge.ico</ApplicationIcon>
    <AssemblyTitle>Steam HID Bridge</AssemblyTitle>
    <Product>Steam HID Bridge</Product>
    <Description>Launch game profiles from Steam and bridge Steam Input toward mouse HID output.</Description>
    <Company>mohdfareed</Company>
    <Authors>mohdfareed</Authors>
    <RepositoryUrl>https://github.com/mohdfareed/steam-hid-bridge</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.*" />
    <PackageReference Include="Viiper.Client" Version="*" />
    <ProjectReference Include="..\SteamHidBridge.Protocol\SteamHidBridge.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SteamHidBridge.ico" />
  </ItemGroup>

</Project>
